<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Faculty - SOET Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/main.css" rel="stylesheet">
  <style>
    body { background:#f0f4ff; font-family:'Segoe UI',sans-serif; }
    .form-card {
      background:white; border-radius:20px; padding:32px;
      box-shadow:0 4px 20px rgba(0,0,0,0.08);
      max-width:620px; margin:0 auto;
    }
    .form-label { font-weight:600; font-size:0.85rem; color:#555; }
    .form-control, .form-select {
      border-radius:10px; border-color:#e0e7ff;
      padding:10px 14px; font-size:0.9rem;
    }
    .form-control:focus, .form-select:focus {
      border-color:#003399;
      box-shadow:0 0 0 3px rgba(0,51,153,0.12);
    }
    .btn-submit {
      background:linear-gradient(135deg,#003399,#0055cc);
      color:white; border:none; border-radius:12px;
      padding:13px; font-weight:700;
      font-size:1rem; width:100%; cursor:pointer;
    }
  </style>
</head>
<body data-authenticated="true">

<%- include('../partials/adminNavbar') %>

<div class="container-fluid px-3 px-md-4 py-4">
<div class="form-card">

  <div class="d-flex align-items-center gap-3 mb-4">
    <div style="width:52px;height:52px;background:#e8f5e9;
      border-radius:14px;display:flex;align-items:center;
      justify-content:center;font-size:1.5rem;color:#2e7d32;">
      <i class="bi bi-person-plus-fill"></i>
    </div>
    <div>
      <h4 class="fw-bold mb-0">Add New Faculty</h4>
      <div class="text-muted" style="font-size:0.82rem;">
        Default password will be Faculty@123
      </div>
    </div>
  </div>

  <% if (error) { %>
    <div class="alert alert-danger d-flex gap-2
      align-items-start mb-4" style="border-radius:12px;">
      <i class="bi bi-exclamation-triangle-fill mt-1"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <form action="/admin/faculty/new" method="POST">

    <div class="row g-3 mb-3">
      <div class="col-12">
        <label class="form-label">
          Full Name <span class="text-danger">*</span>
        </label>
        <input type="text" name="name"
          class="form-control" required
          placeholder="e.g. Dr. Priya Sharma">
      </div>
      <div class="col-12">
        <label class="form-label">
          University Email <span class="text-danger">*</span>
        </label>
        <input type="email" name="email"
          class="form-control" required
          placeholder="firstname.lastname@krmu.edu.in">
      </div>
      <div class="col-6">
        <label class="form-label">
          Employee ID <span class="text-danger">*</span>
        </label>
        <input type="text" name="employeeId"
          class="form-control" required
          placeholder="e.g. EMP018">
      </div>
      <div class="col-6">
        <label class="form-label">
          Role <span class="text-danger">*</span>
        </label>
        <select name="role" class="form-select">
          <option value="faculty">Faculty</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      <div class="col-12">
        <label class="form-label">
          Designation <span class="text-danger">*</span>
        </label>
        <select name="designation" class="form-select" required>
          <option value="">- Select -</option>
          <option value="Professor">Professor</option>
          <option value="Associate Professor">Associate Professor</option>
          <option value="Assistant Professor">Assistant Professor</option>
          <option value="Senior Assistant Professor">Senior Assistant Professor</option>
          <option value="Lab Instructor">Lab Instructor</option>
        </select>
      </div>
      <div class="col-12">
        <label class="form-label">
          Specialization
          <span class="text-muted">(comma separated)</span>
        </label>
        <input type="text" name="specialization"
          class="form-control"
          placeholder="e.g. Machine Learning, Python, Data Science">
        <div class="text-muted mt-1" style="font-size:0.72rem;">
          Separate multiple specializations with commas
        </div>
      </div>
    </div>

    <div style="background:#e8f5e9;border-radius:12px;
      padding:12px 16px;margin-bottom:20px;
      font-size:0.82rem;color:#2e7d32;">
      <i class="bi bi-info-circle-fill me-2"></i>
      The faculty member will be able to login with email
      and default password <strong>Faculty@123</strong>.
      They can change it after first login.
    </div>

    <button type="submit" class="btn-submit">
      <i class="bi bi-person-plus-fill me-2"></i>
      Add Faculty Member
    </button>

  </form>

  <div class="mt-3 text-center">
    <a href="/admin/faculty"
      class="text-muted" style="font-size:0.85rem;">
      <i class="bi bi-arrow-left me-1"></i>Back to Faculty List
    </a>
  </div>

</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
