<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Students - SOET Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/main.css" rel="stylesheet">
  <style>
    body { background:#f0f4ff; font-family:'Segoe UI',sans-serif; }
    .page-card {
      background:white; border-radius:16px;
      border:0.5px solid #e0e7ff;
      box-shadow:0 2px 12px rgba(0,0,0,0.05);
      overflow:hidden;
    }
    .filter-bar {
      background:#f8f9ff; padding:16px 20px;
      border-bottom:0.5px solid #e0e7ff;
    }
    .form-control, .form-select {
      border-radius:8px; border-color:#e0e7ff;
      font-size:0.85rem; padding:8px 12px;
    }
    .table th {
      font-size:0.72rem; text-transform:uppercase;
      letter-spacing:0.5px; color:#666;
      font-weight:700; background:#f8f9ff;
      border-bottom:0.5px solid #e0e7ff;
      padding:12px 16px; white-space:nowrap;
    }
    .table td {
      font-size:0.83rem; vertical-align:middle;
      padding:12px 16px;
      border-bottom:0.5px solid #f5f5f5;
    }
    .table tr:hover td { background:#fafcff; }
    .badge-active {
      background:#e8f5e9; color:#2e7d32;
      font-size:0.7rem; font-weight:700;
      padding:3px 8px; border-radius:6px;
    }
    .badge-inactive {
      background:#fce4ec; color:#c62828;
      font-size:0.7rem; font-weight:700;
      padding:3px 8px; border-radius:6px;
    }
    .roll-tag {
      background:#eef2ff; color:#003399;
      font-size:0.72rem; font-weight:700;
      padding:2px 8px; border-radius:6px;
      font-family:monospace;
    }
    .action-btn {
      font-size:0.75rem; font-weight:600;
      padding:5px 12px; border-radius:8px;
      border:none; cursor:pointer;
      white-space:nowrap;
    }
    .btn-deactivate {
      background:#fce4ec; color:#c62828;
    }
    .btn-activate {
      background:#e8f5e9; color:#2e7d32;
    }
    .pagination-btn {
      padding:6px 12px; border-radius:8px;
      border:0.5px solid #e0e7ff; background:white;
      color:#003399; font-size:0.82rem;
      font-weight:600; text-decoration:none;
      display:inline-block; transition:all 0.15s;
    }
    .pagination-btn:hover,
    .pagination-btn.active {
      background:#003399; color:white;
      border-color:#003399;
    }
  </style>
</head>
<body data-authenticated="true">

<%- include('../partials/adminNavbar') %>

<div class="container-fluid px-3 px-md-4 py-4"
  style="max-width:1300px;margin:0 auto;">

  <% if (success) { %>
    <div id="page-toast" data-message="<%= success %>"
      data-type="success" class="d-none"></div>
  <% } %>
  <% if (error) { %>
    <div id="page-toast" data-message="<%= error %>"
      data-type="error" class="d-none"></div>
  <% } %>

  <div class="d-flex align-items-center
    justify-content-between mb-4 flex-wrap gap-3">
    <div>
      <h4 class="fw-bold mb-1">
        <i class="bi bi-people-fill me-2"
          style="color:#003399;"></i>Manage Students
      </h4>
      <div class="text-muted" style="font-size:0.82rem;">
        <%= total %> students found
      </div>
    </div>
  </div>

  <div class="page-card">

    <div class="filter-bar">
      <form method="GET" action="/admin/students"
        class="row g-2 align-items-end">
        <div class="col-12 col-md-3">
          <input type="text" name="search"
            class="form-control"
            placeholder="Search name, roll no, email..."
            value="<%= filters.search || '' %>">
        </div>
        <div class="col-6 col-md-2">
          <select name="course" class="form-select">
            <option value="">All Courses</option>
            <% courses.forEach(function(c) { %>
              <option value="<%= c.courseCode %>"
                <%= filters.course === c.courseCode ? 'selected' : '' %>>
                <%= c.shortName %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-6 col-md-2">
          <select name="batch" class="form-select">
            <option value="">All Batches</option>
            <option value="2023" <%= filters.batch==='2023'?'selected':'' %>>2023</option>
            <option value="2024" <%= filters.batch==='2024'?'selected':'' %>>2024</option>
          </select>
        </div>
        <div class="col-6 col-md-2">
          <select name="status" class="form-select">
            <option value="">All Status</option>
            <option value="active" <%= filters.status==='active'?'selected':'' %>>Active</option>
            <option value="inactive" <%= filters.status==='inactive'?'selected':'' %>>Inactive</option>
          </select>
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-sm btn-primary"
            style="border-radius:8px;padding:8px 16px;">
            <i class="bi bi-search me-1"></i>Filter
          </button>
        </div>
        <% if (filters.search || filters.course || filters.batch || filters.status) { %>
          <div class="col-auto">
            <a href="/admin/students"
              class="btn btn-sm btn-outline-secondary"
              style="border-radius:8px;">Clear</a>
          </div>
        <% } %>
      </form>
    </div>

    <div class="table-responsive">
      <table class="table mb-0">
        <thead>
          <tr>
            <th>Student</th>
            <th>Roll No</th>
            <th>Course</th>
            <th>Batch</th>
            <th>Section</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (students.length === 0) { %>
            <tr>
              <td colspan="7" style="text-align:center;
                padding:40px;color:#bbb;">
                No students found
              </td>
            </tr>
          <% } else { %>
            <% students.forEach(function(s) { %>
              <tr>
                <td>
                  <div style="font-weight:600;color:#1a1a1a;">
                    <%= s.name %>
                  </div>
                  <div style="font-size:0.72rem;color:#aaa;">
                    <%= s.email %>
                  </div>
                </td>
                <td>
                  <span class="roll-tag"><%= s.rollNo %></span>
                </td>
                <td style="font-size:0.78rem;color:#555;">
                  <%= s.courseCode %>
                </td>
                <td style="font-size:0.82rem;">
                  <%= s.enrollmentYear %>
                </td>
                <td style="font-size:0.82rem;">
                  Sec <%= s.section || 'A' %>
                </td>
                <td>
                  <span class="<%= s.isActive ? 'badge-active' : 'badge-inactive' %>">
                    <%= s.isActive ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td>
                  <form action="/admin/students/<%= s._id %>/toggle"
                    method="POST"
                    onsubmit="return confirm('<%= s.isActive ? 'Deactivate' : 'Activate' %> <%= s.name %>?')">
                    <button type="submit"
                      class="action-btn <%= s.isActive ? 'btn-deactivate' : 'btn-activate' %>">
                      <i class="bi bi-<%= s.isActive ? 'person-x' : 'person-check' %> me-1"></i>
                      <%= s.isActive ? 'Deactivate' : 'Activate' %>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div style="padding:16px 20px;
        border-top:0.5px solid #e0e7ff;
        display:flex;align-items:center;
        justify-content:space-between;flex-wrap:wrap;gap:10px;">
        <div style="font-size:0.78rem;color:#888;">
          Page <%= currentPage %> of <%= totalPages %>
          - <%= total %> total
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <% if (currentPage > 1) { %>
            <a href="/admin/students?page=<%= currentPage-1 %>&search=<%= filters.search||'' %>&course=<%= filters.course||'' %>&batch=<%= filters.batch||'' %>&status=<%= filters.status||'' %>"
              class="pagination-btn">
              Prev
            </a>
          <% } %>
          <% for(let p=Math.max(1,currentPage-2); p<=Math.min(totalPages,currentPage+2); p++) { %>
            <a href="/admin/students?page=<%= p %>&search=<%= filters.search||'' %>&course=<%= filters.course||'' %>&batch=<%= filters.batch||'' %>&status=<%= filters.status||'' %>"
              class="pagination-btn <%= p===currentPage?'active':'' %>">
              <%= p %>
            </a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="/admin/students?page=<%= currentPage+1 %>&search=<%= filters.search||'' %>&course=<%= filters.course||'' %>&batch=<%= filters.batch||'' %>&status=<%= filters.status||'' %>"
              class="pagination-btn">
              Next
            </a>
          <% } %>
        </div>
      </div>
    <% } %>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
