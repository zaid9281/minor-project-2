<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Analytics — SOET Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/main.css" rel="stylesheet">
  <style>
    body { background:#f0f4ff; font-family:'Segoe UI',sans-serif; }
    .stat-card {
      background:white; border-radius:16px; padding:22px;
      border:0.5px solid #e0e7ff;
      box-shadow:0 2px 12px rgba(0,0,0,0.05);
      height:100%; transition:transform 0.2s;
    }
    .stat-card:hover { transform:translateY(-3px); }
    .stat-icon {
      width:50px; height:50px; border-radius:14px;
      display:flex; align-items:center;
      justify-content:center; font-size:1.5rem;
    }
    .section-card {
      background:white; border-radius:16px; padding:24px;
      border:0.5px solid #e0e7ff;
      box-shadow:0 2px 12px rgba(0,0,0,0.05);
      margin-bottom:20px;
    }
    .section-title {
      font-size:0.9rem; font-weight:700; color:#333;
      margin-bottom:16px; display:flex;
      align-items:center; gap:8px;
      padding-bottom:12px;
      border-bottom:0.5px solid #f0f0f0;
    }
    .bar-chart-wrap {
      display:flex; align-items:flex-end;
      gap:6px; height:140px;
    }
    .bar-item {
      flex:1; display:flex; flex-direction:column;
      align-items:center; justify-content:flex-end; gap:4px;
    }
    .bar-fill {
      width:100%; border-radius:6px 6px 0 0;
      min-height:4px; transition:height 0.8s ease;
    }
    .bar-label {
      font-size:0.62rem; color:#aaa;
      text-align:center; white-space:nowrap;
    }
    .bar-count {
      font-size:0.68rem; font-weight:700; color:#003399;
    }
    .page-bar-wrap { margin-bottom:12px; }
    .page-bar-label {
      display:flex; justify-content:space-between;
      margin-bottom:4px;
    }
    .page-name {
      font-size:0.82rem; font-weight:600; color:#333;
    }
    .page-count {
      font-size:0.78rem; color:#888;
    }
    .bar-track {
      height:8px; background:#f0f4ff;
      border-radius:4px; overflow:hidden;
    }
    .bar-track-fill {
      height:100%; border-radius:4px;
    }
    .hour-grid {
      display:grid; grid-template-columns:repeat(24,1fr);
      gap:3px; margin-top:8px;
    }
    .hour-cell {
      height:32px; border-radius:4px;
      display:flex; align-items:center;
      justify-content:center;
      font-size:0.55rem; color:white;
      font-weight:700; cursor:default;
    }
    .action-row {
      display:flex; align-items:center; gap:12px;
      padding:10px 0; border-bottom:0.5px solid #f5f5f5;
    }
    .action-row:last-child { border-bottom:none; }
    .action-icon {
      width:34px; height:34px; border-radius:10px;
      display:flex; align-items:center;
      justify-content:center; font-size:0.95rem;
      flex-shrink:0;
    }
    .growth-badge {
      font-size:0.75rem; font-weight:700;
      padding:3px 8px; border-radius:6px;
    }
    .growth-up { background:#e8f5e9; color:#2e7d32; }
    .growth-down { background:#fce4ec; color:#c62828; }
    .subject-row {
      display:flex; align-items:center; gap:10px;
      padding:8px 0; border-bottom:0.5px solid #f5f5f5;
    }
    .subject-row:last-child { border-bottom:none; }
  </style>
</head>
<body data-authenticated="true">

<%- include('../partials/adminNavbar') %>

<div class="container-fluid px-3 px-md-4 py-4"
  style="max-width:1300px;margin:0 auto;">

  <div class="d-flex align-items-center
    justify-content-between mb-4 flex-wrap gap-3">
    <div>
      <h4 class="fw-bold mb-1">
        <i class="bi bi-graph-up-arrow me-2"
          style="color:#003399;"></i>
        Portal Usage Analytics
      </h4>
      <div class="text-muted" style="font-size:0.82rem;">
        How students and faculty are using the portal
      </div>
    </div>
    <a href="/admin/overview"
      style="background:white;color:#003399;
        border:2px solid #e0e7ff;border-radius:10px;
        padding:8px 18px;font-weight:600;
        font-size:0.85rem;text-decoration:none;">
      <i class="bi bi-arrow-left me-1"></i>Overview
    </a>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon mb-3" style="background:#eef2ff;">
          <i class="bi bi-people-fill" style="color:#003399;"></i>
        </div>
        <div style="font-size:2rem;font-weight:800;
          color:#003399;line-height:1;">
          <%= todayUsers %>
        </div>
        <div style="font-size:0.78rem;color:#888;margin-top:4px;">
          Active Users Today
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon mb-3" style="background:#e8f5e9;">
          <i class="bi bi-activity" style="color:#2e7d32;"></i>
        </div>
        <div style="font-size:2rem;font-weight:800;
          color:#2e7d32;line-height:1;">
          <%= thisWeek %>
        </div>
        <div style="font-size:0.78rem;color:#888;margin-top:4px;">
          Actions This Week
        </div>
        <div style="margin-top:6px;">
          <span class="growth-badge <%= weeklyGrowth >= 0 ? 'growth-up' : 'growth-down' %>">
            <%= weeklyGrowth >= 0 ? '↑' : '↓' %>
            <%= Math.abs(weeklyGrowth) %>% vs last week
          </span>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon mb-3" style="background:#fff3e0;">
          <i class="bi bi-bar-chart-fill" style="color:#e65100;"></i>
        </div>
        <div style="font-size:2rem;font-weight:800;
          color:#e65100;line-height:1;">
          <%= totalEvents.toLocaleString('en-IN') %>
        </div>
        <div style="font-size:0.78rem;color:#888;margin-top:4px;">
          Total Events Logged
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-icon mb-3" style="background:#f3e5f5;">
          <i class="bi bi-clock-fill" style="color:#7b1fa2;"></i>
        </div>
        <%
          const maxHour = hourlyData.reduce((m, h) => h.count > m.count ? h : m, hourlyData[0]);
        %>
        <div style="font-size:2rem;font-weight:800;
          color:#7b1fa2;line-height:1;">
          <%= maxHour ? maxHour.label : '--' %>
        </div>
        <div style="font-size:0.78rem;color:#888;margin-top:4px;">
          Peak Usage Hour
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-12 col-lg-8">
      <div class="section-card">
        <div class="section-title">
          <i class="bi bi-people-fill" style="color:#003399;"></i>
          Daily Active Users — Last 7 Days
        </div>
        <% const maxDAU = Math.max(...last7Days.map(d => d.count), 1); %>
        <div class="bar-chart-wrap">
          <% last7Days.forEach(function(day) { %>
            <div class="bar-item">
              <div class="bar-count">
                <%= day.count > 0 ? day.count : '' %>
              </div>
              <div class="bar-fill"
                style="height:<%= Math.max(Math.round((day.count/maxDAU)*130), day.count > 0 ? 10 : 4) %>px;
                  background:<%= day.count > 0 ? 'linear-gradient(180deg,#0055cc,#003399)' : '#e0e7ff' %>;"></div>
              <div class="bar-label"><%= day.date %></div>
            </div>
          <% }); %>
        </div>
        <div style="margin-top:10px;font-size:0.72rem;
          color:#aaa;text-align:center;">
          Total unique users across the last 7 days:
          <%= last7Days.reduce(function(s, d) { return s + d.count; }, 0) %>
        </div>
      </div>

      <div class="section-card">
        <div class="section-title">
          <i class="bi bi-eye-fill" style="color:#e65100;"></i>
          Most Visited Pages
        </div>
        <% if (pageVisits.length === 0) { %>
          <div style="text-align:center;padding:24px;color:#bbb;">
            No page visits tracked yet
          </div>
        <% } else { %>
          <% const maxVisit = pageVisits[0].visits || 1; %>
          <%
            const barColors = [
              '#003399','#0055cc','#0077ff',
              '#2e7d32','#43a047','#7b1fa2',
              '#c62828','#e65100'
            ];
          %>
          <% pageVisits.forEach(function(p, i) { %>
            <div class="page-bar-wrap">
              <div class="page-bar-label">
                <span class="page-name"><%= p.page %></span>
                <span class="page-count">
                  <%= p.visits %> visits
                  &nbsp;·&nbsp;
                  <span style="color:#003399;">
                    <%= p.uniqueUsers %> unique
                  </span>
                </span>
              </div>
              <div class="bar-track">
                <div class="bar-track-fill"
                  style="width:<%= Math.round((p.visits/maxVisit)*100) %>%;
                    background:<%= barColors[i % barColors.length] %>;"></div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

      <div class="section-card">
        <div class="section-title">
          <i class="bi bi-clock-fill" style="color:#7b1fa2;"></i>
          Peak Usage Hours (Last 30 Days)
        </div>
        <%
          const maxHourCount = Math.max(...hourlyData.map(h => h.count), 1);
          const getHeatColor = (count) => {
            const intensity = count / maxHourCount;
            if (intensity === 0) return '#f0f4ff';
            if (intensity < 0.25) return '#b3c8f7';
            if (intensity < 0.5) return '#6699ee';
            if (intensity < 0.75) return '#3366cc';
            return '#003399';
          };
          const getTextColor = (count) => {
            const intensity = count / maxHourCount;
            return intensity < 0.25 ? '#003399' : 'white';
          };
        %>
        <div class="hour-grid">
          <% hourlyData.forEach(function(h) { %>
            <div class="hour-cell"
              style="background:<%= getHeatColor(h.count) %>;
                color:<%= getTextColor(h.count) %>;"
              title="<%= h.label %>: <%= h.count %> actions">
              <%= h.count > 0 ? h.count : '' %>
            </div>
          <% }); %>
        </div>
        <div style="display:grid;grid-template-columns:repeat(24,1fr);
          gap:3px;margin-top:4px;">
          <% hourlyData.forEach(function(h) { %>
            <div style="text-align:center;font-size:0.55rem;
              color:#aaa;overflow:hidden;">
              <%= h.label %>
            </div>
          <% }); %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="section-card">
        <div class="section-title">
          <i class="bi bi-pie-chart-fill" style="color:#003399;"></i>
          Activity Breakdown
        </div>
        <%
          const actionIcons = {
            page_view: { icon:'bi-grid-fill', bg:'#eef2ff', color:'#003399', label:'Page Views' },
            material_view: { icon:'bi-file-earmark-text-fill', bg:'#e8f5e9', color:'#2e7d32', label:'Material Views' },
            pyq_view: { icon:'bi-file-earmark-pdf-fill', bg:'#f3e5f5', color:'#7b1fa2', label:'PYQ Views' },
            syllabus_view: { icon:'bi-journal-text', bg:'#e8f5e9', color:'#1b5e20', label:'Syllabus Views' },
            forum_view: { icon:'bi-chat-dots-fill', bg:'#fff3e0', color:'#e65100', label:'Forum Views' },
            announcement_view: { icon:'bi-megaphone-fill', bg:'#fce4ec', color:'#c62828', label:'Announcements' },
            search: { icon:'bi-search', bg:'#e3f2fd', color:'#1565c0', label:'Searches' }
          };
          const totalActions = actionBreakdown.reduce((s, a) => s + a.count, 0) || 1;
        %>
        <% if (actionBreakdown.length === 0) { %>
          <div style="text-align:center;padding:24px;color:#bbb;">
            No activity logged yet
          </div>
        <% } else { %>
          <% actionBreakdown.forEach(function(a) { %>
            <% const cfg = actionIcons[a._id] || { icon:'bi-circle', bg:'#f5f5f5', color:'#666', label: a._id }; %>
            <div class="action-row">
              <div class="action-icon" style="background:<%= cfg.bg %>;">
                <i class="bi <%= cfg.icon %>" style="color:<%= cfg.color %>;"></i>
              </div>
              <div style="flex-grow:1;min-width:0;">
                <div style="font-size:0.82rem;font-weight:600;color:#1a1a1a;">
                  <%= cfg.label %>
                </div>
                <div style="height:5px;background:#f0f4ff;border-radius:3px;margin-top:4px;overflow:hidden;">
                  <div style="height:100%;border-radius:3px;background:<%= cfg.color %>;width:<%= Math.round((a.count/totalActions)*100) %>%;"></div>
                </div>
              </div>
              <span style="font-size:0.78rem;font-weight:700;color:#333;flex-shrink:0;">
                <%= a.count %>
              </span>
            </div>
          <% }); %>
        <% } %>
      </div>

      <div class="section-card">
        <div class="section-title">
          <i class="bi bi-person-fill" style="color:#2e7d32;"></i>
          Usage by Role
        </div>
        <%
          const roleColors = {
            student: { bg:'#eef2ff', color:'#003399' },
            faculty: { bg:'#e8f5e9', color:'#2e7d32' },
            admin: { bg:'#fff3e0', color:'#e65100' }
          };
          const totalRole = roleBreakdown.reduce((s, r) => s + r.count, 0) || 1;
        %>
        <% if (roleBreakdown.length === 0) { %>
          <div style="text-align:center;padding:24px;color:#bbb;">
            No data yet
          </div>
        <% } else { %>
          <% roleBreakdown.forEach(function(r) { %>
            <% const rc = roleColors[r._id] || { bg:'#f5f5f5', color:'#666' }; %>
            <div style="margin-bottom:16px;">
              <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
                <span style="font-size:0.85rem;font-weight:700;color:<%= rc.color %>;"><%= r._id.charAt(0).toUpperCase() + r._id.slice(1) %></span>
                <span style="font-size:0.82rem;color:#888;"><%= r.count %> actions (<%= Math.round((r.count/totalRole)*100) %>%)</span>
              </div>
              <div style="height:10px;background:#f0f4ff;border-radius:5px;overflow:hidden;">
                <div style="height:100%;border-radius:5px;background:<%= rc.color %>;width:<%= Math.round((r.count/totalRole)*100) %>%;"></div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

      <div class="section-card">
        <div class="section-title">
          <i class="bi bi-journal-richtext" style="color:#e65100;"></i>
          Most Accessed Subjects
        </div>
        <% if (subjectActivity.length === 0) { %>
          <div style="text-align:center;padding:24px;color:#bbb;">
            No subject access tracked yet
          </div>
        <% } else { %>
          <% subjectActivity.forEach(function(s, i) { %>
            <div class="subject-row">
              <div style="width:24px;height:24px;border-radius:8px;background:#eef2ff;display:flex;align-items:center;justify-content:center;font-size:0.72rem;font-weight:800;color:#003399;flex-shrink:0;">
                <%= i + 1 %>
              </div>
              <div style="flex-grow:1;min-width:0;">
                <div style="font-size:0.8rem;font-weight:600;color:#333;">
                  <%= s._id %>
                </div>
                <div style="font-size:0.7rem;color:#aaa;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                  <%= subjectNameMap[s._id] || '' %>
                </div>
              </div>
              <span style="background:#f0f4ff;color:#003399;font-size:0.72rem;font-weight:700;padding:2px 8px;border-radius:6px;white-space:nowrap;flex-shrink:0;">
                <%= s.visits %> views
              </span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <div class="text-center text-muted py-3 mt-2"
    style="font-size:0.75rem;border-top:1px solid #e0e7ff;">
    SOET Resource Portal &copy; <%= new Date().getFullYear() %>
    · KR Mangalam University
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>