<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Logs - SOET Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/main.css" rel="stylesheet">
  <style>
    body { background:#f0f4ff; font-family:'Segoe UI',sans-serif; }
    .page-card {
      background:white; border-radius:16px;
      border:0.5px solid #e0e7ff;
      box-shadow:0 2px 12px rgba(0,0,0,0.05);
      overflow:hidden;
    }
    .filter-bar {
      background:#f8f9ff; padding:16px 20px;
      border-bottom:0.5px solid #e0e7ff;
    }
    .form-control, .form-select {
      border-radius:8px; border-color:#e0e7ff;
      font-size:0.85rem; padding:8px 12px;
    }
    .table th {
      font-size:0.72rem; text-transform:uppercase;
      letter-spacing:0.5px; color:#666; font-weight:700;
      background:#f8f9ff;
      border-bottom:0.5px solid #e0e7ff;
      padding:12px 16px;
    }
    .table td {
      font-size:0.82rem; vertical-align:middle;
      padding:12px 16px;
      border-bottom:0.5px solid #f5f5f5;
    }
    .table tr:hover td { background:#fafcff; }
    .role-badge {
      font-size:0.7rem; font-weight:700;
      padding:3px 8px; border-radius:6px;
    }
    .role-student { background:#eef2ff; color:#003399; }
    .role-faculty { background:#e8f5e9; color:#2e7d32; }
    .role-admin { background:#fff3e0; color:#e65100; }
    .pagination-btn {
      padding:6px 12px; border-radius:8px;
      border:0.5px solid #e0e7ff; background:white;
      color:#003399; font-size:0.82rem;
      font-weight:600; text-decoration:none;
      display:inline-block;
    }
    .pagination-btn.active {
      background:#003399; color:white; border-color:#003399;
    }
    .stat-pill {
      background:white; border-radius:12px;
      border:0.5px solid #e0e7ff; padding:12px 20px;
      text-align:center;
    }
  </style>
</head>
<body data-authenticated="true">

<%- include('../partials/adminNavbar') %>

<div class="container-fluid px-3 px-md-4 py-4"
  style="max-width:1200px;margin:0 auto;">

  <div class="d-flex align-items-center
    justify-content-between mb-3 flex-wrap gap-3">
    <h4 class="fw-bold mb-0">
      <i class="bi bi-journal-text me-2"
        style="color:#c62828;"></i>Login Audit Logs
    </h4>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-pill">
        <div style="font-size:1.6rem;font-weight:800;
          color:#003399;"><%= totalLogins %></div>
        <div style="font-size:0.75rem;color:#888;">
          Total Logins
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-pill">
        <div style="font-size:1.6rem;font-weight:800;
          color:#c62828;"><%= todayLogins %></div>
        <div style="font-size:0.75rem;color:#888;">
          Today
        </div>
      </div>
    </div>
  </div>

  <div class="page-card">

    <div class="filter-bar">
      <form method="GET" action="/admin/logs"
        class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
          <input type="text" name="search"
            class="form-control"
            placeholder="Search name or email..."
            value="<%= filters.search || '' %>">
        </div>
        <div class="col-auto">
          <select name="role" class="form-select">
            <option value="">All Roles</option>
            <option value="student"
              <%= filters.role==='student'?'selected':'' %>>
              Student
            </option>
            <option value="faculty"
              <%= filters.role==='faculty'?'selected':'' %>>
              Faculty
            </option>
            <option value="admin"
              <%= filters.role==='admin'?'selected':'' %>>
              Admin
            </option>
          </select>
        </div>
        <div class="col-auto">
          <button type="submit"
            class="btn btn-sm btn-primary"
            style="border-radius:8px;padding:8px 16px;">
            <i class="bi bi-search me-1"></i>Filter
          </button>
        </div>
        <% if (filters.search || filters.role) { %>
          <div class="col-auto">
            <a href="/admin/logs"
              class="btn btn-sm btn-outline-secondary"
              style="border-radius:8px;">Clear</a>
          </div>
        <% } %>
      </form>
    </div>

    <div class="table-responsive">
      <table class="table mb-0">
        <thead>
          <tr>
            <th>User</th>
            <th>Role</th>
            <th>Login Time</th>
            <th>IP Address</th>
            <th>Device</th>
          </tr>
        </thead>
        <tbody>
          <% if (logs.length === 0) { %>
            <tr>
              <td colspan="5"
                style="text-align:center;padding:40px;color:#bbb;">
                No logs found
              </td>
            </tr>
          <% } else { %>
            <% logs.forEach(function(log) { %>
              <tr>
                <td>
                  <div style="font-weight:600;color:#1a1a1a;">
                    <%= log.userName %>
                  </div>
                  <div style="font-size:0.72rem;color:#aaa;">
                    <%= log.userEmail %>
                  </div>
                </td>
                <td>
                  <span class="role-badge role-<%= log.userRole %>">
                    <%= log.userRole %>
                  </span>
                </td>
                <td>
                  <div style="font-size:0.82rem;color:#333;">
                    <%= new Date(log.loginAt).toLocaleDateString(
                      'en-IN',
                      {day:'numeric',month:'short',year:'numeric'}
                    ) %>
                  </div>
                  <div style="font-size:0.72rem;color:#aaa;">
                    <%= new Date(log.loginAt).toLocaleTimeString(
                      'en-IN',
                      {hour:'2-digit',minute:'2-digit',hour12:true}
                    ) %>
                  </div>
                </td>
                <td style="font-family:monospace;
                  font-size:0.78rem;color:#666;">
                  <%= log.ipAddress || '-' %>
                </td>
                <td style="font-size:0.72rem;color:#888;
                  max-width:200px;overflow:hidden;
                  text-overflow:ellipsis;white-space:nowrap;">
                  <%= log.userAgent
                    ? log.userAgent.substring(0,60) + '...'
                    : '-' %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div style="padding:16px 20px;
        border-top:0.5px solid #e0e7ff;
        display:flex;align-items:center;
        justify-content:space-between;flex-wrap:wrap;gap:10px;">
        <div style="font-size:0.78rem;color:#888;">
          Page <%= currentPage %> of <%= totalPages %>
        </div>
        <div class="d-flex gap-2">
          <% if (currentPage > 1) { %>
            <a href="/admin/logs?page=<%= currentPage-1 %>&search=<%= filters.search||'' %>&role=<%= filters.role||'' %>"
              class="pagination-btn">Prev</a>
          <% } %>
          <% if (currentPage < totalPages) { %>
            <a href="/admin/logs?page=<%= currentPage+1 %>&search=<%= filters.search||'' %>&role=<%= filters.role||'' %>"
              class="pagination-btn">Next</a>
          <% } %>
        </div>
      </div>
    <% } %>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
