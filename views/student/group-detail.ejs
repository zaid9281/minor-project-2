<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= group.name %> — Study Group</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/main.css" rel="stylesheet">
  <style>
    body { background:var(--bg-page); font-family:'Segoe UI',sans-serif; }
    .group-hero {
      background:linear-gradient(135deg,#7b1fa2,#9c27b0);
      border-radius:18px; color:white; padding:22px 26px; margin-bottom:18px;
    }
    .invite-box {
      background:rgba(255,255,255,0.15); border-radius:10px;
      padding:8px 14px; font-family:monospace; font-weight:700;
      font-size:1.1rem; letter-spacing:2px; display:inline-block;
    }
    .members-card, .chat-card {
      background:var(--bg-card); border-radius:16px;
      border:1.5px solid var(--border-color); padding:20px;
      margin-bottom:16px;
    }
    .member-row {
      display:flex; align-items:center; gap:10px;
      padding:8px 0; border-bottom:0.5px solid var(--border-color);
    }
    .member-row:last-child { border-bottom:none; }
    .msg-bubble {
      background:var(--bg-card-alt); border-radius:12px;
      padding:10px 14px; margin-bottom:10px; max-width:85%;
    }
    .msg-bubble.own {
      background:#f3e5f5; margin-left:auto;
    }
    .chat-window {
      max-height:380px; overflow-y:auto; padding-right:6px; margin-bottom:14px;
    }
    .back-btn {
      background:var(--bg-card); color:#7b1fa2;
      border:2px solid var(--border-color); border-radius:10px;
      padding:7px 16px; font-weight:600; font-size:0.82rem;
      text-decoration:none; display:inline-flex; align-items:center;
      gap:6px; margin-bottom:16px;
    }
  </style>
</head>
<body data-authenticated="true">

<%- include('../partials/studentNavbar') %>

<div class="container-fluid px-3 px-md-4 py-4"
  style="max-width:800px;margin:0 auto;">

  <% if (success) { %>
    <div id="page-toast" data-message="<%= success %>" data-type="success" class="d-none"></div>
  <% } %>
  <% if (error) { %>
    <div id="page-toast" data-message="<%= error %>" data-type="error" class="d-none"></div>
  <% } %>

  <a href="/groups" class="back-btn">
    <i class="bi bi-arrow-left"></i>All Groups
  </a>

  <div class="group-hero">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
      <div>
        <h5 class="fw-bold mb-1"><%= group.name %></h5>
        <div style="opacity:0.85;font-size:0.82rem;">
          <%= group.subjectCode %> · <%= group.subjectName %>
        </div>
        <% if (group.description) { %>
          <div style="opacity:0.75;font-size:0.8rem;margin-top:6px;">
            <%= group.description %>
          </div>
        <% } %>
      </div>
      <div class="text-end">
        <div style="font-size:0.72rem;opacity:0.8;margin-bottom:4px;">Invite Code</div>
        <div class="invite-box"><%= group.inviteCode %></div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-md-4">
      <div class="members-card">
        <h6 class="fw-bold mb-3" style="font-size:0.85rem;">
          <i class="bi bi-people-fill me-2" style="color:#7b1fa2;"></i>
          Members (<%= group.members.length %>/<%= group.maxMembers %>)
        </h6>
        <% group.members.forEach(function(m) { %>
          <div class="member-row">
            <div style="width:30px;height:30px;border-radius:8px;background:#f3e5f5;color:#7b1fa2;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;">
              <%= m.name.charAt(0).toUpperCase() %>
            </div>
            <div style="flex-grow:1;min-width:0;">
              <div style="font-size:0.82rem;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                <%= m.name %>
                <% if (m.studentId.toString() === group.creatorId.toString()) { %>
                  <span style="color:#e65100;font-size:0.68rem;">★</span>
                <% } %>
              </div>
            </div>
            <% if (isCreator && m.studentId.toString() !== user.id) { %>
              <button onclick="removeMember('<%= m.studentId %>', this)"
                style="background:none;border:none;color:#c62828;font-size:0.85rem;cursor:pointer;">
                <i class="bi bi-x-circle"></i>
              </button>
            <% } %>
          </div>
        <% }); %>

        <% if (isCreator) { %>
          <form action="/groups/<%= group._id %>/delete" method="POST"
            onsubmit="return confirm('Delete this group permanently?')" class="mt-3">
            <button type="submit"
              style="width:100%;background:#fce4ec;color:#c62828;border:none;border-radius:8px;padding:8px;font-size:0.78rem;font-weight:700;cursor:pointer;">
              <i class="bi bi-trash me-1"></i>Delete Group
            </button>
          </form>
        <% } else { %>
          <form action="/groups/<%= group._id %>/leave" method="POST"
            onsubmit="return confirm('Leave this group?')" class="mt-3">
            <button type="submit"
              style="width:100%;background:#f5f5f5;color:#666;border:none;border-radius:8px;padding:8px;font-size:0.78rem;font-weight:700;cursor:pointer;">
              <i class="bi bi-box-arrow-left me-1"></i>Leave Group
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="col-12 col-md-8">
      <div class="chat-card">
        <h6 class="fw-bold mb-3" style="font-size:0.85rem;">
          <i class="bi bi-chat-square-text-fill me-2" style="color:#7b1fa2;"></i>
          Group Notes & Chat
        </h6>

        <div class="chat-window" id="chatWindow">
          <% if (messages.length === 0) { %>
            <div style="text-align:center;padding:24px;color:var(--text-faint);font-size:0.82rem;">
              No messages yet. Share a note or start the conversation!
            </div>
          <% } %>
          <% messages.forEach(function(m) { %>
            <div class="msg-bubble <%= m.senderId.toString() === user.id ? 'own' : '' %>">
              <div style="font-size:0.72rem;font-weight:700;color:#7b1fa2;margin-bottom:3px;">
                <%= m.senderName %>
              </div>
              <div style="font-size:0.85rem;color:var(--text-primary);line-height:1.5;">
                <%= m.content %>
              </div>
              <% if (m.linkUrl) { %>
                <a href="<%= m.linkUrl %>" target="_blank"
                  style="font-size:0.78rem;color:#1565c0;display:block;margin-top:4px;word-break:break-all;">
                  <i class="bi bi-link-45deg me-1"></i><%= m.linkUrl %>
                </a>
              <% } %>
              <div style="font-size:0.68rem;color:var(--text-faint);margin-top:4px;">
                <%= new Date(m.createdAt).toLocaleString('en-IN', {day:'numeric',month:'short',hour:'2-digit',minute:'2-digit',hour12:true}) %>
              </div>
            </div>
          <% }); %>
        </div>

        <form action="/groups/<%= group._id %>/message" method="POST">
          <div class="mb-2">
            <textarea name="content" rows="2" required maxlength="1000"
              placeholder="Share a note, ask a question, or post a thought..."
              style="width:100%;border-radius:10px;border:0.5px solid var(--border-color);background:var(--bg-card-alt);color:var(--text-primary);padding:10px 14px;font-size:0.85rem;resize:none;"></textarea>
          </div>
          <div class="mb-2">
            <input type="url" name="linkUrl" maxlength="500"
              placeholder="Optional link (Drive, YouTube, etc.)"
              style="width:100%;border-radius:10px;border:0.5px solid var(--border-color);background:var(--bg-card-alt);color:var(--text-primary);padding:8px 14px;font-size:0.8rem;">
          </div>
          <button type="submit"
            style="background:linear-gradient(135deg,#7b1fa2,#9c27b0);color:white;border:none;border-radius:10px;padding:9px 22px;font-weight:700;font-size:0.85rem;cursor:pointer;">
            <i class="bi bi-send-fill me-2"></i>Send
          </button>
        </form>
      </div>
    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
  var chatWin = document.getElementById('chatWindow');
  if (chatWin) chatWin.scrollTop = chatWin.scrollHeight;

  async function removeMember(memberId, btn) {
    if (!confirm('Remove this member from the group?')) return;
    var res = await fetch(window.location.pathname + '/remove-member', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ memberId })
    });
    var data = await res.json();
    if (data.success) {
      window.location.reload();
    } else {
      alert(data.message || 'Failed to remove member.');
    }
  }
</script>
</body>
</html>