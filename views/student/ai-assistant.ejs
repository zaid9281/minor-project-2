<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Study Assistant — <%= subject.name %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/main.css" rel="stylesheet">
  <style>
    body { background:var(--bg-page); font-family:'Segoe UI',sans-serif; }

    .hero {
      background:linear-gradient(135deg,#1a1a2e,#003399);
      border-radius:20px; color:white;
      padding:24px 28px; margin-bottom:20px;
    }
    .ai-badge {
      background:linear-gradient(135deg,#FFB800,#FF8C00);
      color:#1a1a1a; font-size:0.72rem; font-weight:800;
      padding:3px 10px; border-radius:20px;
      display:inline-flex; align-items:center; gap:4px;
    }
    .chat-container {
      background:var(--bg-card); border-radius:20px;
      border:1.5px solid var(--border-color);
      overflow:hidden; display:flex; flex-direction:column;
      height:calc(100vh - 280px); min-height:500px;
    }
    .chat-header {
      background:linear-gradient(135deg,#003399,#0055cc);
      padding:14px 20px; display:flex;
      align-items:center; justify-content:space-between;
      flex-shrink:0;
    }
    .chat-window {
      flex-grow:1; overflow-y:auto; padding:20px;
      display:flex; flex-direction:column; gap:14px;
      scroll-behavior:smooth;
    }
    .chat-window::-webkit-scrollbar { width:4px; }
    .chat-window::-webkit-scrollbar-track { background:transparent; }
    .chat-window::-webkit-scrollbar-thumb { background:#e0e7ff; border-radius:2px; }

    .msg {
      display:flex; gap:10px; align-items:flex-start;
      animation:fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
      from { opacity:0; transform:translateY(8px); }
      to { opacity:1; transform:translateY(0); }
    }
    .msg.user { flex-direction:row-reverse; }

    .msg-avatar {
      width:34px; height:34px; border-radius:10px;
      display:flex; align-items:center; justify-content:center;
      font-size:0.9rem; flex-shrink:0; font-weight:700;
    }
    .msg.user .msg-avatar {
      background:#eef2ff; color:#003399;
    }
    .msg.ai .msg-avatar {
      background:linear-gradient(135deg,#FFB800,#FF8C00);
      color:#1a1a1a;
    }

    .msg-bubble {
      max-width:78%; padding:12px 16px; border-radius:14px;
      font-size:0.88rem; line-height:1.6;
    }
    .msg.user .msg-bubble {
      background:#003399; color:white;
      border-bottom-right-radius:4px;
    }
    .msg.ai .msg-bubble {
      background:var(--bg-card-alt);
      border:0.5px solid var(--border-color);
      color:var(--text-primary);
      border-bottom-left-radius:4px;
    }
    .msg.ai .msg-bubble p { margin-bottom:8px; }
    .msg.ai .msg-bubble p:last-child { margin-bottom:0; }
    .msg.ai .msg-bubble ul,
    .msg.ai .msg-bubble ol {
      padding-left:20px; margin-bottom:8px;
    }
    .msg.ai .msg-bubble li { margin-bottom:4px; }
    .msg.ai .msg-bubble strong { color:#003399; }
    .msg.ai .msg-bubble code {
      background:#eef2ff; color:#003399;
      padding:1px 6px; border-radius:4px;
      font-size:0.82rem;
    }

    .msg-time {
      font-size:0.65rem; color:var(--text-faint);
      margin-top:4px;
      text-align:right;
    }
    .msg.ai .msg-time { text-align:left; }

    .typing-indicator {
      display:flex; gap:5px; align-items:center;
      padding:12px 16px; background:var(--bg-card-alt);
      border:0.5px solid var(--border-color);
      border-radius:14px; border-bottom-left-radius:4px;
      width:fit-content;
    }
    .typing-dot {
      width:7px; height:7px; background:#003399;
      border-radius:50%; animation:typingBounce 1.2s infinite;
    }
    .typing-dot:nth-child(2) { animation-delay:0.2s; }
    .typing-dot:nth-child(3) { animation-delay:0.4s; }
    @keyframes typingBounce {
      0%,60%,100% { transform:translateY(0); }
      30% { transform:translateY(-6px); }
    }

    .chat-input-area {
      padding:14px 16px;
      border-top:0.5px solid var(--border-color);
      background:var(--bg-card); flex-shrink:0;
    }
    .input-wrap {
      display:flex; gap:10px; align-items:flex-end;
      background:var(--bg-card-alt);
      border:1.5px solid var(--border-color);
      border-radius:14px; padding:8px 12px;
      transition:border-color 0.2s;
    }
    .input-wrap:focus-within { border-color:#003399; }
    #userInput {
      flex-grow:1; border:none; background:transparent;
      color:var(--text-primary); font-size:0.88rem;
      resize:none; outline:none; max-height:100px;
      font-family:'Segoe UI',sans-serif; line-height:1.5;
    }
    #userInput::placeholder { color:var(--text-faint); }
    .send-btn {
      background:linear-gradient(135deg,#003399,#0055cc);
      color:white; border:none; border-radius:10px;
      width:38px; height:38px; display:flex;
      align-items:center; justify-content:center;
      cursor:pointer; flex-shrink:0;
      transition:all 0.2s; font-size:1rem;
    }
    .send-btn:hover { transform:scale(1.05); }
    .send-btn:disabled { opacity:0.5; cursor:not-allowed; transform:none; }

    .suggestion-chips {
      display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;
    }
    .chip {
      background:var(--bg-card-alt);
      border:1px solid var(--border-color);
      border-radius:20px; padding:6px 14px;
      font-size:0.78rem; color:var(--text-secondary);
      cursor:pointer; transition:all 0.2s;
      white-space:nowrap;
    }
    .chip:hover {
      background:#eef2ff; color:#003399;
      border-color:#003399;
    }

    .context-sidebar {
      background:var(--bg-card); border-radius:16px;
      border:1.5px solid var(--border-color); padding:18px;
      position:sticky; top:20px;
    }
    .unit-item {
      padding:8px 12px; border-radius:10px;
      font-size:0.8rem; color:var(--text-secondary);
      border:0.5px solid var(--border-color);
      margin-bottom:6px; cursor:pointer;
      transition:all 0.15s;
    }
    .unit-item:hover {
      background:#eef2ff; color:#003399;
      border-color:#003399;
    }
    .back-btn {
      background:var(--bg-card); color:#003399;
      border:2px solid var(--border-color); border-radius:10px;
      padding:7px 16px; font-weight:600; font-size:0.82rem;
      text-decoration:none; display:inline-flex;
      align-items:center; gap:6px; margin-bottom:16px;
    }
    .back-btn:hover { background:#003399; color:white; border-color:#003399; }
    .clear-btn {
      background:none; border:none; color:rgba(255,255,255,0.6);
      font-size:0.78rem; cursor:pointer; padding:4px 10px;
      border-radius:6px; transition:all 0.15s;
    }
    .clear-btn:hover { background:rgba(255,255,255,0.1); color:white; }
  </style>
</head>
<body data-authenticated="true">

<%- include('../partials/studentNavbar') %>

<div class="container-fluid px-3 px-md-4 py-3"
  style="max-width:1200px;margin:0 auto;">

  <a href="/student/dashboard" class="back-btn">
    <i class="bi bi-arrow-left"></i>Dashboard
  </a>

  <div class="hero">
    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
      <div>
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="ai-badge">
            <i class="bi bi-stars"></i>AI Powered
          </span>
          <span style="background:rgba(255,255,255,0.15);color:rgba(255,255,255,0.8);font-size:0.72rem;font-weight:600;padding:3px 10px;border-radius:20px;">
            Gemini 1.5 Flash
          </span>
        </div>
        <h4 class="fw-bold mb-1">
          AI Study Assistant
        </h4>
        <div style="opacity:0.85;font-size:0.88rem;">
          <%= subject.subjectCode %> — <%= subject.name %>
        </div>
        <div style="opacity:0.65;font-size:0.78rem;margin-top:4px;">
          Semester <%= subject.semester %> ·
          <%= subject.credits %> Credits · <%= subject.type %>
        </div>
      </div>
      <div style="text-align:right;">
        <div style="font-size:0.72rem;opacity:0.7;margin-bottom:4px;">
          Powered by Google Gemini
        </div>
        <div style="font-size:1.8rem;">🤖</div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-lg-8">
      <div class="chat-container">
        <div class="chat-header">
          <div class="d-flex align-items-center gap-2">
            <div style="width:10px;height:10px;background:#4caf50;border-radius:50%;animation:pulse 2s infinite;"></div>
            <span style="color:white;font-weight:600;font-size:0.88rem;">
              AI Tutor — <%= subject.name %>
            </span>
          </div>
          <button class="clear-btn" type="button" data-action="clear-chat">
            <i class="bi bi-trash me-1"></i>Clear chat
          </button>
        </div>

        <div class="chat-window" id="chatWindow">
          <div class="msg ai" id="welcome-msg">
            <div class="msg-avatar">🤖</div>
            <div>
              <div class="msg-bubble">
                <p>👋 Hello! I'm your AI study assistant for <strong><%= subject.name %></strong>.</p>
                <p>I can help you with:</p>
                <ul>
                  <li>Explaining concepts and topics</li>
                  <li>Answering questions about the syllabus</li>
                  <li>Giving examples and analogies</li>
                  <li>Helping you prepare for exams</li>
                </ul>
                <p>What would you like to learn today? 📚</p>
              </div>
              <div class="msg-time">Just now</div>
            </div>
          </div>
        </div>

        <div style="padding:10px 16px 0;flex-shrink:0;">
          <div class="suggestion-chips" id="suggestions">
            <button type="button" class="chip" data-suggestion="What%20is%20this%20subject%20about%3F">
              What is this subject about?
            </button>
            <button type="button" class="chip" data-suggestion="Explain%20Unit%201%20concepts">
              Explain Unit 1 concepts
            </button>
            <button type="button" class="chip" data-suggestion="Give%20me%20important%20topics%20for%20exam">
              Give me important topics for exam
            </button>
            <button type="button" class="chip" data-suggestion="Give%20me%20a%20short%20quiz">
              Give me a short quiz
            </button>
          </div>
        </div>

        <div class="chat-input-area">
          <div class="input-wrap">
            <textarea id="userInput" rows="1"
              placeholder="Ask anything about <%= subject.name %>..."
              onkeydown="handleKeyDown(event)"
              oninput="autoResize(this)"></textarea>
            <button class="send-btn" id="sendBtn" type="button" onclick="sendMessage()">
              <i class="bi bi-send-fill"></i>
            </button>
          </div>
          <div style="text-align:center;font-size:0.68rem;color:var(--text-faint);margin-top:6px;">
            AI can make mistakes. Verify important information.
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="context-sidebar">
        <h6 class="fw-bold mb-3" style="font-size:0.88rem;">
          <i class="bi bi-journal-richtext me-2" style="color:#003399;"></i>
          Subject Topics
        </h6>

        <% if (materials.length > 0) { %>
          <div style="font-size:0.75rem;color:var(--text-faint);margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px;">
            Available Materials
          </div>
          <% const units = {}; %>
          <% materials.forEach(function(m) { %>
            <% if (!units[m.unit]) units[m.unit] = []; %>
            <% units[m.unit].push(m); %>
          <% }); %>
          <% Object.keys(units).sort().forEach(function(unit) { %>
            <div style="margin-bottom:10px;">
              <div style="font-size:0.72rem;font-weight:700;color:#003399;margin-bottom:4px;text-transform:uppercase;">
                Unit <%= unit %>
              </div>
              <% units[unit].forEach(function(m) { %>
                <button type="button" class="unit-item topic-item" data-topic="<%= encodeURIComponent(m.title) %>">
                  <i class="bi bi-file-earmark-text me-2" style="color:#003399;font-size:0.75rem;"></i>
                  <%= m.title %>
                </button>
              <% }); %>
            </div>
          <% }); %>
        <% } else { %>
          <div style="text-align:center;padding:20px;color:var(--text-faint);font-size:0.82rem;">
            <i class="bi bi-folder2-open" style="font-size:1.8rem;display:block;margin-bottom:8px;"></i>
            No materials uploaded yet
          </div>
        <% } %>

        <hr style="border-color:var(--border-color);margin:14px 0;">

        <div style="font-size:0.75rem;color:var(--text-faint);margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px;">
          Quick Questions
        </div>
        <% [
          'What are the key topics I should study?',
          'Explain the most important concept in this subject',
          'What are common exam questions?',
          'Give me a summary of this subject',
          'What are real-world applications?'
        ].forEach(function(q) { %>
          <button type="button" class="unit-item topic-item" data-topic="<%= encodeURIComponent(q) %>">
            <i class="bi bi-question-circle me-2" style="color:#7b1fa2;font-size:0.75rem;"></i>
            <%= q %>
          </button>
        <% }); %>

        <hr style="border-color:var(--border-color);margin:14px 0;">

        <div style="font-size:0.72rem;color:var(--text-faint);line-height:1.5;">
          <i class="bi bi-info-circle me-1"></i>
          This AI assistant knows about
          <strong><%= subject.name %></strong> and the
          <%= materials.length %> material<%= materials.length !== 1 ? 's' : '' %>
          uploaded for this subject.
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes pulse {
    0%,100% { opacity:1; }
    50% { opacity:0.4; }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="/js/main.js"></script>
<script>
  var subjectCode = '<%= subject.subjectCode %>';
  var chatHistory = [];
  var isTyping = false;

  function autoResize(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 100) + 'px';
  }

  function handleKeyDown(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  }

  function formatResponse(text) {
    if (typeof marked !== 'undefined') {
      return marked.parse(text);
    }
    return text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/`(.*?)`/g, '<code>$1</code>')
      .replace(/\n\n/g, '</p><p>')
      .replace(/\n/g, '<br>')
      .replace(/^/, '<p>')
      .replace(/$/, '</p>');
  }

  function getTime() {
    return new Date().toLocaleTimeString('en-IN', {
      hour: '2-digit', minute: '2-digit', hour12: true
    });
  }

  function addMessage(role, content, isHTML) {
    var win = document.getElementById('chatWindow');
    var div = document.createElement('div');
    div.className = 'msg ' + role;

    var time = getTime();
    var avatarContent = role === 'user'
      ? '<%= user.name.charAt(0).toUpperCase() %>'
      : '🤖';

    div.innerHTML =
      '<div class="msg-avatar">' + avatarContent + '</div>' +
      '<div>' +
        '<div class="msg-bubble">' +
          (isHTML ? content : '<p>' + content + '</p>') +
        '</div>' +
        '<div class="msg-time">' + time + '</div>' +
      '</div>';

    win.appendChild(div);
    win.scrollTop = win.scrollHeight;
    return div;
  }

  function showTyping() {
    var win = document.getElementById('chatWindow');
    var div = document.createElement('div');
    div.className = 'msg ai';
    div.id = 'typing-indicator';
    div.innerHTML =
      '<div class="msg-avatar">🤖</div>' +
      '<div class="typing-indicator">' +
        '<div class="typing-dot"></div>' +
        '<div class="typing-dot"></div>' +
        '<div class="typing-dot"></div>' +
      '</div>';
    win.appendChild(div);
    win.scrollTop = win.scrollHeight;
  }

  function removeTyping() {
    var el = document.getElementById('typing-indicator');
    if (el) el.remove();
  }

  async function sendMessage() {
    if (isTyping) return;

    var input = document.getElementById('userInput');
    var message = input.value.trim();
    if (!message) return;

    input.value = '';
    input.style.height = 'auto';

    var suggestions = document.getElementById('suggestions');
    if (suggestions) suggestions.style.display = 'none';

    addMessage('user', message, false);
    chatHistory.push({ role: 'user', content: message });

    isTyping = true;
    document.getElementById('sendBtn').disabled = true;
    showTyping();

    try {
      var res = await fetch('/ai/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: message,
          subjectCode: subjectCode,
          history: chatHistory.slice(0, -1)
        })
      });

      var data = await res.json();
      removeTyping();

      if (data.success) {
        var formatted = formatResponse(data.reply);
        addMessage('ai', formatted, true);
        chatHistory.push({ role: 'model', content: data.reply });

        if (chatHistory.length > 20) {
          chatHistory = chatHistory.slice(-20);
        }
      } else {
        addMessage('ai',
          '<p style="color:#c62828;">⚠️ ' + (data.error || 'Something went wrong. Please try again.') + '</p>',
          true
        );
      }
    } catch (err) {
      removeTyping();
      addMessage('ai',
        '<p style="color:#c62828;">⚠️ Network error. Please check your connection and try again.</p>',
        true
      );
    } finally {
      isTyping = false;
      document.getElementById('sendBtn').disabled = false;
      input.focus();
    }
  }

  function clearChat() {
    if (!confirm('Clear the chat history?')) return;
    chatHistory = [];
    var win = document.getElementById('chatWindow');
    var msgs = win.querySelectorAll('.msg:not(#welcome-msg)');
    msgs.forEach(function(m) { m.remove(); });
    var suggestions = document.getElementById('suggestions');
    if (suggestions) suggestions.style.display = 'flex';
  }

  document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('userInput').focus();

    document.querySelectorAll('.chip[data-suggestion]').forEach(function(button) {
      button.addEventListener('click', function() {
        document.getElementById('userInput').value = decodeURIComponent(button.getAttribute('data-suggestion'));
        sendMessage();
      });
    });

    document.querySelectorAll('.topic-item[data-topic]').forEach(function(button) {
      button.addEventListener('click', function() {
        document.getElementById('userInput').value = decodeURIComponent(button.getAttribute('data-topic'));
        document.getElementById('userInput').focus();
      });
    });

    var clearButton = document.querySelector('[data-action="clear-chat"]');
    if (clearButton) {
      clearButton.addEventListener('click', clearChat);
    }
  });
</script>
</body>
</html>
